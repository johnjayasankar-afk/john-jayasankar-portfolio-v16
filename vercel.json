{
  "trailingSlash": false,
  "redirects": [
    { "source": "/ridelens", "destination": "https://ride-lens2.vercel.app/", "permanent": false },
    { "source": "/raildrop", "destination": "https://rail-drop3.vercel.app/", "permanent": false },
    { "source": "/daylight", "destination": "https://daylight-app-wine.vercel.app/", "permanent": false },
    { "source": "/agentfit", "destination": "https://ride-lens2.vercel.app/", "permanent": false },
    { "source": "/opportunity-os", "destination": "https://rail-drop3.vercel.app/", "permanent": false },
    { "source": "/apps/agentfit", "destination": "https://ride-lens2.vercel.app/", "permanent": false },
    { "source": "/apps/agentfit/:path*", "destination": "https://ride-lens2.vercel.app/", "permanent": false },
    { "source": "/apps/opportunity-os", "destination": "https://rail-drop3.vercel.app/", "permanent": false },
    { "source": "/apps/opportunity-os/:path*", "destination": "https://rail-drop3.vercel.app/", "permanent": false },
    { "source": "/work/agentfit", "destination": "/work/ridelens", "permanent": true },
    { "source": "/work/opportunity-os", "destination": "/work/raildrop", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/john-jayasankar.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
