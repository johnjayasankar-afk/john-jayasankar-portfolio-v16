{
  "rewrites": [
    { "source": "/apps/agentfit", "destination": "/apps/agentfit/index.html" },
    { "source": "/apps/agentfit/", "destination": "/apps/agentfit/index.html" },
    { "source": "/apps/agentfit/:path*", "destination": "/apps/agentfit/index.html" },
    { "source": "/apps/opportunity-os", "destination": "/apps/opportunity-os/index.html" },
    { "source": "/apps/opportunity-os/", "destination": "/apps/opportunity-os/index.html" },
    { "source": "/apps/opportunity-os/:path*", "destination": "/apps/opportunity-os/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/apps/:app/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/john-jayasankar.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
